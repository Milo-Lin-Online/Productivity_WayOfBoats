# Copy this file to `.env` and fill in the values, then run `npm start`.

# ── Discord ──────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot.
DISCORD_TOKEN=

# The channel the bot listens in (name, without the leading #).
DISCORD_CHANNEL=glitch-things

# ── Supabase (the SAME values the website uses) ──────────
# On the site, open the Sync settings dialog — these are the url, key and room
# you typed there. The anon key is fine; it's the same one the browsers use.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ROOM=
